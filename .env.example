# ==========================================================
# Configuración de Entorno de AppCalorias (Ejemplo)
# ==========================================================
# Copiá este archivo como `.env` si tu entorno utiliza inyección de variables.
# En el frontend actual (Vanilla Web ESM), estas credenciales están configuradas
# en `frontend/js/data/supabase.js`.

# URL del proyecto Supabase
SUPABASE_URL=https://yqvrssewbltzxmlvynuw.supabase.co

# Clave pública / anónima de Supabase (Publishable Key)
# Esta clave está pensada para ser pública en el navegador. La seguridad y el control
# de acceso están gobernados exclusivamente por las políticas Row Level Security (RLS)
# en la base de datos PostgreSQL.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_7yOo8nZzdSu5izzN-KmnGw_cmwwWY-v

# Puerto local para el servidor estático de desarrollo
PORT=3000
